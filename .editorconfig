root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.css]
indent_style = space
indent_size = 4

[*.html]
indent_style = tab

[*.sh]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.plist]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
